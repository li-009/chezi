# 环境配置示例
# 复制此文件为 .env 并填写实际值

# 服务器配置
PORT=5000
HOST=0.0.0.0
DEBUG=true

# 数据库配置 (SQLite)
DATABASE_PATH=./chezi.db

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini AI (可选)
GEMINI_API_KEY=your-gemini-api-key
